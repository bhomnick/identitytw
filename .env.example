# Copy to .env for local development. Production uses real environment variables.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# Defaults to SQLite at identity/db.sqlite3 when unset.
#DATABASE_URL=postgres://user:password@localhost:5432/identitytw

# Production only: HTTPS redirect, HSTS and secure cookies.
#USE_SSL=true

# Redirect <HEROKU_APP>.herokuapp.com to the canonical domain.
#HEROKU_APP=identitytw
#HEROKU_DOMAIN=identity.tw
